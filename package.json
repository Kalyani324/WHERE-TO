{
  "name": "whereto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json",
    "emulators": "firebase emulators:start --only auth,database --project demo-whereto",
    "api": "FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx watch scripts/dev-api.ts",
    "dev:all": "npm run emulators & npm run api & vite"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@vercel/functions": "^3.9.11",
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/node": "^23.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.33.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.52.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}

# --- Client (Vite, public) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to 1 for local dev against the Firebase emulator
VITE_USE_EMULATOR=1

# --- Server (Vercel functions, secret) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Whole service-account JSON (or base64 of it)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=
# 1 = never call the AI, use mock content
AI_MOCK=0
# Global AI requests per minute (free tier is ~5-15)
AI_RPM=8
